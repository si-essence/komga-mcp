# Required. Self-hosted Komga origin. No userinfo, query, or hash.
KOMGA_URL=http://127.0.0.1:25600

# API key from Komga User settings. Sent as the X-API-Key header. Never printed.
KOMGA_API_KEY=

# Optional alternative to KOMGA_API_KEY. Both must be set. Sent as HTTP basic auth.
# KOMGA_USERNAME=
# KOMGA_PASSWORD=

# Literal true sends confirmed writes. Any other value keeps writes as dry-run previews.
KOMGA_ALLOW_WRITES=false

# Comma-separated toolsets, or all. Default is the read-focused set in the README.
# KOMGA_TOOLSETS=libraries,series,books

# Local sliding window. Cache hits do not spend it.
KOMGA_PER_MINUTE=30

# Cache TTL in seconds for reads. 0 disables caching.
KOMGA_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
KOMGA_TIMEOUT_MS=20000

# Contact embedded in the User-Agent. Must not be the API key or password.
KOMGA_CONTACT=you@example.com

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
